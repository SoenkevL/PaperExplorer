# Copy to .env and fill in. Every setting is a PE_* variable (packages/core/src/paperexplorer/config.py).

# Postgres (compose service `db`)
POSTGRES_USER=paperexplorer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paperexplorer
PE_DATABASE_URL=postgresql://paperexplorer:change-me@localhost:5432/paperexplorer

# Local data (cache for PDFs and parser output)
PE_DATA_DIR=data

# Embeddings: any OpenAI-compatible endpoint (Ollama by default)
PE_EMBEDDING_BASE_URL=http://localhost:11434/v1
PE_EMBEDDING_MODEL=bge-m3
PE_EMBEDDING_API_KEY=ollama
# Texts per request; each request is one embedding observation in its trace.
PE_EMBEDDING_BATCH_SIZE=32

# Answers: the cosine (bge-m3) an Answer sentence needs with a Chunk sentence for close Support.
# Set from the eval of 2026-10-29 (docs/eval-2026-10-29.md).
PE_SUPPORT_THRESHOLD=0.7

# The answering agent's chat model: any OpenAI-compatible endpoint (Ollama by default). The model
# is the Modelfile alias scripts/setup-tower.sh creates; PE_CHAT_NUM_CTX repeats its num_ctx for
# the traces.
PE_CHAT_BASE_URL=http://localhost:11434/v1
PE_CHAT_MODEL=paperexplorer-chat
PE_CHAT_API_KEY=ollama
PE_CHAT_NUM_CTX=73728
# Seconds a chat request may wait for its stream's next bytes before the turn fails.
PE_CHAT_TIMEOUT_S=120
# Sampling temperature, sent with every chat request and recorded on its trace.
PE_CHAT_TEMPERATURE=0.5
# Whether the model thinks before it answers on a request that offers no tools (the whole Seed's,
# retrieval's last, and the one asking again for handles). Requests with tools always think.
PE_CHAT_ANSWER_THINKING=false
# A Seed of at most this many bge-m3 tokens (the sum of its Chunks') is answered from whole, in
# context and without tools; a larger one is searched (ADR 0010). Must stay below PE_CHAT_NUM_CTX.
PE_WHOLE_SEED_MAX_TOKENS=40000

# Conversations live in the API's memory (a restart clears them): beyond this many the least
# recently used is evicted, and any left unused this long.
PE_CONVERSATIONS_MAX=50
PE_CONVERSATION_IDLE_MINUTES=120

# Zotero Web API (zotero.org/settings/keys)
PE_ZOTERO_LIBRARY_ID=
PE_ZOTERO_LIBRARY_TYPE=user
PE_ZOTERO_API_KEY=
# Optional: local Zotero storage folder (read-only), e.g. /home/<you>/Zotero/storage
PE_ZOTERO_STORAGE_DIR=
# Tower: the same folder, mounted read-only into the compose pipeline container
ZOTERO_STORAGE_HOST_DIR=

# Registry Checks (optional): Crossref's polite pool and an OpenAlex key raise their limits
PE_CROSSREF_MAILTO=
PE_OPENALEX_API_KEY=

# Parsing: GROBID finds the structure (compose service `grobid`); Tesseract data for scans.
PE_GROBID_URL=http://localhost:8070
# Optional: folder holding eng.traineddata; empty lets LiteParse download it on first OCR.
PE_TESSDATA_DIR=

# Tracing (Langfuse). One key pair for both hosts: create a project on Langfuse Cloud (EU) and
# use its keys; the tower's project is initialised with the same keys (compose.langfuse.yaml).
# No keys: tracing is off. The tower is used whenever it answers, else the fallback.
PE_LANGFUSE_PUBLIC_KEY=
PE_LANGFUSE_SECRET_KEY=
PE_LANGFUSE_BASE_URL=http://pop-os.local:3000
PE_LANGFUSE_FALLBACK_URL=https://cloud.langfuse.com
# development (Mac), tower (compose services), eval
PE_LANGFUSE_ENVIRONMENT=development
# Optional: release on every trace; empty means the git SHA where git is available.
PE_LANGFUSE_RELEASE=
# The tower's trace store is pruned, oldest first, once it holds this much on disk.
PE_LANGFUSE_TRACE_CAP_GB=6

# Langfuse server on the tower (compose.langfuse.yaml). Generate each secret with
# `openssl rand -hex 32`. NEXTAUTH_URL is the address you open the UI at.
LANGFUSE_NEXTAUTH_URL=http://pop-os.local:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
# After you have signed up in the UI, set true and recreate langfuse-web.
LANGFUSE_DISABLE_SIGNUP=false

# Logging
PE_LOG_LEVEL=INFO
PE_LOG_FORMAT=text

# Web app
PE_WEB_API_URL=http://localhost:8000
