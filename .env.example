# Copy to .env and fill in. Every setting is a PE_* variable (packages/core/src/paperexplorer/config.py).

# Postgres (compose service `db`)
POSTGRES_USER=paperexplorer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=paperexplorer
PE_DATABASE_URL=postgresql://paperexplorer:change-me@localhost:5432/paperexplorer

# Local data (cache for PDFs and parser output)
PE_DATA_DIR=data

# Embeddings: any OpenAI-compatible endpoint (Ollama by default)
PE_EMBEDDING_BASE_URL=http://localhost:11434/v1
PE_EMBEDDING_MODEL=bge-m3
PE_EMBEDDING_API_KEY=ollama

# Zotero Web API (zotero.org/settings/keys)
PE_ZOTERO_LIBRARY_ID=
PE_ZOTERO_LIBRARY_TYPE=user
PE_ZOTERO_API_KEY=
# Optional: local Zotero storage folder (read-only), e.g. /home/<you>/Zotero/storage
PE_ZOTERO_STORAGE_DIR=

# Logging
PE_LOG_LEVEL=INFO
PE_LOG_FORMAT=text

# Web app
PE_WEB_API_URL=http://localhost:8000
